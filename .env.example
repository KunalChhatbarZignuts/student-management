# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/student_mgmt

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ── Invite / Password Reset ─────────────────────────────
INVITE_EXPIRE_HOURS=48
RESET_EXPIRE_MINUTES=30

# ── Cookie ───────────────────────────────────────────────
COOKIE_SECURE=false

# ── Email / Mailtrap SMTP ─────────────────────────────────
EMAIL_BACKEND=smtp
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_smtp_username
SMTP_PASSWORD=your_mailtrap_smtp_password
SMTP_FROM_EMAIL=noreply@school.local
SMTP_FROM_NAME="School Management System"
SMTP_TLS=false
SMTP_SSL=false

# ── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Feature Flags ────────────────────────────────────────
ENABLE_ONLINE_APPLICATIONS=false

# ── Payment Gateway (Razorpay) ───────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Seed Super Admin (used by seed script) ───────────────
SEED_SUPER_ADMIN_EMAIL=admin@school.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@1234

# LiveKit Video Conferencing
LIVEKIT_URL=wss://your-livekit-server-url
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ── Hugging Face AI Configuration ────────────────────────
HUGGINGFACE_API_TOKEN=your-huggingface-api-token
HUGGINGFACE_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
AI_FALLBACK_DETERMINISTIC=true
