# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/student_mgmt

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ── Invite / Password Reset ─────────────────────────────
INVITE_EXPIRE_HOURS=48
RESET_EXPIRE_MINUTES=30

# ── Cookie ───────────────────────────────────────────────
COOKIE_SECURE=false

# ── Email ────────────────────────────────────────────────
EMAIL_BACKEND=console

# ── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Feature Flags ────────────────────────────────────────
ENABLE_ONLINE_APPLICATIONS=false

# ── Payment Gateway (Razorpay) ───────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Seed Super Admin (used by seed script) ───────────────
SEED_SUPER_ADMIN_EMAIL=admin@school.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@1234
